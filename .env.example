# Public site URL — no trailing slash. Used for canonical, OG, sitemap, robots.
# Set to the Vercel URL or the live domain (e.g. https://blueeco.com.bd).
NEXT_PUBLIC_SITE_URL=https://blueeco.com.bd

# Web3Forms access key (public by design). Get one at https://web3forms.com
# Forms silently fail ("not configured") until this is set.
NEXT_PUBLIC_WEB3FORMS_KEY=
